 /**********************************************************************
+/* block_sigusr1: Increment refcount to block deferred SIGUSR1 delivery.
+ * Call before any context access in a syscall handler to prevent a race. */
+static void block_sigusr1( void )
+{
+    amd64_thread_data()->sigusr1_blocked++;
+}
+
+/* unblock_sigusr1: Decrement refcount. If SIGUSR1 arrived while blocked,
+ * run the deferred handler now that we're outside the critical section. */
+static void unblock_sigusr1( void )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+
+    if (data->sigusr1_blocked > 0)
+        data->sigusr1_blocked--;
+    if (data->sigusr1_blocked == 0 && data->sigusr1_pending)
+    {
+        data->sigusr1_pending = 0;
+        deferred_sigusr1( get_syscall_frame() );
+    }
+}
+
+/* deferred_sigusr1: Rewind the syscall RIP so the instruction is re-executed
+ * after a deferred SIGUSR1 was delivered. Called with the current frame.
+ * __attribute__((used)) prevents GCC DCE from dropping it, since its only
+ * non-static call site is inside unblock_sigusr1 and other refs are inline asm. */
+__attribute__((used)) static void deferred_sigusr1( struct syscall_frame *frame )
+{
+    if (!frame) return;
+    frame->rip -= 2;  /* rewind past the syscall instruction */
+}
+
+/***********************************************************************
  *		usr1_handler
  *
  * Handler for SIGUSR1, used to signal a thread that it got suspended.
@@ -2763,6 +2811,14 @@
 {
