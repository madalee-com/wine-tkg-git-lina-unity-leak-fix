diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 751d955c564..5b58e5a57be 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -520,8 +520,13 @@ struct amd64_thread_data
     DWORD                 fs;            /* 0338 WOW TEB selector */
     DWORD                 mxcsr;         /* 033c Unix-side mxcsr register */
     char                  syscall_dispatch; /* 0340 */
+    volatile char         sigusr1_blocked;  /* 0341 */
+    volatile char         sigusr1_pending;  /* 0342 */
 };
 
+C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, sigusr1_blocked ) == 0x341 );
+C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, sigusr1_pending ) == 0x342 );
+
 C_ASSERT( sizeof(struct amd64_thread_data) <= sizeof(((struct ntdll_thread_data *)0)->cpu_data) );
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, pthread_teb ) == 0x320 );
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, frame_size ) == 0x328 );
@@ -535,6 +540,16 @@ static inline struct amd64_thread_data *amd64_thread_data(void)
     return (struct amd64_thread_data *)ntdll_get_thread_data()->cpu_data;
 }
 
+static inline void block_sigusr1(void)
+{
+    amd64_thread_data()->sigusr1_blocked++;
+}
+
+static inline void unblock_sigusr1(void)
+{
+    amd64_thread_data()->sigusr1_blocked--;
+}
+
 static unsigned int frame_size;
 static unsigned int xstate_size = sizeof(XSAVE_AREA_HEADER);
 static UINT64 xstate_extended_features;
@@ -2783,7 +2798,9 @@ static void usr1_handler( int signal, siginfo_t *siginfo, void *sigcontext )
             frame->eflags = 0x200;
             fixup_frame_fpu_state( frame, ucontext );
         }
+        block_sigusr1();
         NtGetContextThread( GetCurrentThread(), &context->c );
+        unblock_sigusr1();
         if (xstate_extended_features)
         {
             if (user_shared_data->XState.CompactionEnabled)
@@ -2806,7 +2823,9 @@ static void usr1_handler( int signal, siginfo_t *siginfo, void *sigcontext )
 
             cpu->Flags |= WOW64_CPURESERVED_FLAG_RESET_STATE;
         }
+        block_sigusr1();
         NtSetContextThread( GetCurrentThread(), &context->c );
+        unblock_sigusr1();
     }
     else
     {
