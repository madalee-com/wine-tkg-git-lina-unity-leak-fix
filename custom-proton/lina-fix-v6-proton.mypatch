@@ -2920,7 +2934,52 @@ static void quit_handler( int signal, siginfo_t *siginfo, void *sigcontext )
 
 
 /**********************************************************************
- *		usr1_handler
+ */*
+ * block_sigusr1: Increment refcount and block SIGUSR1 for current thread.
+ * Call before any context access in syscall handler to prevent race.
+ */
+static void block_sigusr1(void)
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+    sigset_t mask;
+
+    sigprocmask( SIG_BLOCK, &signal_usr1_mask, NULL );
+    data->sigusr1_blocked++;
+}
+
+/*
+ * unblock_sigusr1: Decrement refcount and unblock SIGUSR1.
+ * If SIGUSR1 was pending while blocked, run deferred handler.
+ */
+static void unblock_sigusr1(void)
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+
+    if (data->sigusr1_blocked > 0)
+        data->sigusr1_blocked--;
+    if (data->sigusr1_blocked == 0 && data->sigusr1_pending)
+    {
+        data->sigusr1_pending = 0;
+        deferred_sigusr1();
+    }
+    sigprocmask( SIG_UNBLOCK, &signal_usr1_mask, NULL );
+}
+
+/*
+ * deferred_sigusr1: Rewind syscall RIP so the syscall is re-executed
+ * after SIGUSR1 was handled. Called when a blocked SIGUSR1 needs
+ * processing but we're inside a syscall handler.
+ */
+static void deferred_sigusr1(void)
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+    struct syscall_frame *frame = data->syscall_frame;
+    if (!frame) return;
+    data->sigusr1_pending = 0;  /* consume pending before re-entering */
+    frame->rip -= 2;  /* rewind past syscall instruction */
+}
+
+		usr1_handler
  *
  * Handler for SIGUSR1, used to signal a thread that it got suspended.
  */
@@ -2928,6 +2987,13 @@ static void usr1_handler( int signal, siginfo_t *siginfo, void *sigcontext )
 {
     ucontext_t *ucontext = init_handler( sigcontext );
 
+    /* Prevent SIGUSR1 from running while we manipulate context structures. */
+    if (is_inside_syscall( ucontext ) && amd64_thread_data()->sigusr1_blocked)
+    {
+        amd64_thread_data()->sigusr1_pending = 1;
+        return;
+    }
+
     if (is_inside_syscall( RSP_sig(ucontext) ))
     {
         struct syscall_frame *frame = get_syscall_frame();
@@ -3494,6 +3560,14 @@ __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
                    __ASM_CFI(".cfi_remember_state\n\t")
                    __ASM_CFI_CFA_IS_AT2(rcx, 0xa8, 0x01) /* frame->syscall_cfa */
                    "leaq 0x70(%rcx),%rsp\n\t"      /* %rsp > frame means no longer inside syscall */
+                   "movq %rax,0xb8(%rcx)\n\t"      /* frame->retval */
+                   "movb %gs:0x341,%al\n\t"        /* load sigusr1_pending (gs-relative) */
+                   "testb %al,%al\n\t"             /* check if set */
+                   "jz 5f\n\t"
+                   "pushq %rcx\n\t"                /* save frame ptr across call */
+                   "call " __ASM_NAME("deferred_sigusr1") "\n\t"
+                   "popq %rcx\n\t"                 /* restore frame ptr */
+                   "5:\n\t"
 #ifdef __linux__
                    "movw 0x338(%r13),%dx\n"        /* amd64_thread_data()->fs */
                    "testw %dx,%dx\n\t"
@@ -3597,12 +3671,14 @@ __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
                    "popfq\n\t"
                    "iretq\n"
                    /* RESTORE_FLAGS_INSTRUMENTATION */
-                   "2:\tmovq %gs:0x330,%r10\n\t"  /* amd64_thread_data()->instrumentation_callback */
+                   "2:\tmovq 0x70(%rcx),%r11\n\t"  /* save frame->rip */
+                   "movq %gs:0x330,%r10\n\t"  /* amd64_thread_data()->instrumentation_callback */
                    "movq (%r10),%r10\n\t"
                    "test %r10,%r10\n\t"
                    "jz 3b\n\t"
                    "testl $0x2,%edx\n\t"          /* CONTEXT_INTEGER */
                    "jnz 1b\n\t"
+                   "movq %r11,%r10\n\t"             /* restore frame->rip as r10 for NtSetContextThread */
                    "xchgq %r10,(%rsp)\n\t"
                    "pushq %r11\n\t"
                    /* make sure that if trap flag is set the trap happens on the first instruction after iret */
